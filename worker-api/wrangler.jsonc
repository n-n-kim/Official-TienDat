{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "official",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "official-tiendat-chat",
      "database_id": "replace-with-your-d1-database-id"
    }
  ]
}
